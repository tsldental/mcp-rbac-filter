# URL of the upstream Azure Functions MCP server to proxy requests to.
# Trailing slash is optional — the proxy normalises it automatically.
TARGET_URL=https://<your-function-app>.azurewebsites.net/api

# Port this proxy listens on (default: 3000)
PORT=3000

# --- JWT Verification (required in production) ---
# Your Entra ID (Azure AD) tenant ID.
# When set, every incoming Bearer token is verified against Microsoft's JWKS.
# When absent, the proxy falls back to decode-only mode (dev use only).
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The audience claim expected in the JWT — typically your app registration's
# Application (client) ID, or a custom Application ID URI like:
# api://<your-function-app-client-id>
AUDIENCE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
